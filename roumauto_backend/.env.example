# Base (exemple — copier vers .env et remplir)
# PORT=5000
# JWT_SECRET=votre_secret_tres_long
# DB_HOST=localhost
# ...

# ---------- EMAIL (obligatoire pour les envois) ----------
# Compte qui ENVOIE les mails (Gmail : utiliser un "Mot de passe d'application", pas le mot de passe du compte)
# https://support.google.com/accounts/answer/185833
EMAIL_USER=votre.email@gmail.com
EMAIL_PASSWORD=xxxxxxxxxxxxxxxx
# Optionnel : en-tête From (sinon = RY Performance <EMAIL_USER>)
# EMAIL_FROM=RY Performance <votre.email@gmail.com>

# Destinataire des alertes admin (demande d'accès). Si vide, EMAIL_USER est utilisé.
ADMIN_EMAIL=votre.email@gmail.com

# ---------- SMTP personnalisé (FAI, Office365, etc.) — laisser vide pour Gmail ----------
# Exemple Gmail si vous forcez le host (sinon le code utilise 587 + IPv4 tout seul) :
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false

# Debug (logs détaillés nodemailer dans la console du serveur) :
# SMTP_DEBUG=1

# Test manuel depuis roumauto_backend : npm run test:email
# Optionnel : TEST_TO=vous@example.com

# Fichier lu en priorité : roumauto_backend/.env , sinon .env à la racine du projet.
